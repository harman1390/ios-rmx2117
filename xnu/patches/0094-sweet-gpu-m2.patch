+void
+sweet_gpu_init(void)
+{
+	static int started;
+	int enabled = 0;
+	thread_t thread;
+	if (started)
+		return;
+	started = 1;
+	(void)PE_parse_boot_argn("sweetgpu", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetgpu_keep", &g_keep, sizeof(g_keep));
+	(void)PE_parse_boot_argn("sweetgpu_nojob", &g_nojob, sizeof(g_nojob));
+	if (!enabled) {
+		LOG("off (sweetgpu=1 to power on Mali-G57 and run the M2 test)\n");
+		return;
+	}
+	g_pwrap = ml_io_map(GPU_PWRAP_PA, 0x1000);
+	g_spm = ml_io_map(GPU_SPM_PA, 0x1000);
+	g_infra = ml_io_map(GPU_INFRA_PA, 0x1000);
+	g_ipdn = ml_io_map(GPU_IPDN_PA, 0x1000);
+	g_mfgcfg = ml_io_map(GPU_MFGCFG_PA, 0x1000);
+	g_mali = ml_io_map(GPU_MALI_PA, 0x4000);
+	if (!g_pwrap || !g_spm || !g_infra || !g_ipdn || !g_mfgcfg || !g_mali) {
+		LOG("MMIO map failed\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(gpu_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS)
+		thread_deallocate(thread);
+	else
+		LOG("kernel_thread_start failed %d\n", kr);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
