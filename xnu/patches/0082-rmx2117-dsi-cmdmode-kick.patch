diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 0000000..0000000 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -720,6 +720,23 @@
 static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+
+static volatile uint32_t *fbcon_kick_reg;
+
+/*
+ * rmx2117 (MT6853): the panel runs in DSI command mode. OVL scans the
+ * DRAM framebuffer, but a frame only reaches the panel's GRAM after
+ * dsi0 DSI_START (+0xC) toggles 0->1. The "kick-reg" ADT property of
+ * the sweet-fbcon node carries the dsi0 register block's phys address.
+ */
+static void
+fbcon_kick(void)
+{
+	if (fbcon_kick_reg != NULL) {
+		fbcon_kick_reg[3] = 0;	/* DSI_START */
+		fbcon_kick_reg[3] = 1;
+	}
+}
 
 static void
 fbcon_clear_row(uint32_t row)
@@ -786,6 +800,7 @@
 		}
 	}
 	fbcon_col++;
+	fbcon_kick();
 }
 
 static unsigned int
@@ -837,6 +852,12 @@
 	sweet_early_mark(17, "fbcon config read; mapping");
 	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
 	sweet_early_mark(18, "fbcon mapping returned");
+	{
+		uint64_t const *kick;
+		if (SecureDTGetProperty(entry, "kick-reg", (void const **)&kick, &size) == kSuccess && size == 8) {
+			fbcon_kick_reg = (volatile uint32_t *)ml_io_map(kick[0], 0x1000);
+		}
+	}
 	if (fbcon_base != NULL) {
 		register_serial_functions(&sweet_fbcon_serial_functions);
 	}
