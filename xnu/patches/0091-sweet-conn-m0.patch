+/*
+ * SWEET MT6853 connectivity (Wi-Fi/BT, MT6635 conninfra) milestone M0:
+ * power the CONN MTCMOS domain, release its bus protection and read the
+ * CONNSYS hardware IP version at CONN_MCU_CONFIG_BASE(0x18002000)+0x110.
+ *
+ * Sequences copied from vendor clk-mt6853-pg.c (spm_mtcmos_ctrl_conn_*):
+ *   SPM 0x10006000: CONN_PWR_CON=0x304, PWR_STATUS=0x16c/0x170 (bit1)
+ *   PWR_CON bits: RST_B=b0 ISO=b1 ON=b2 ON_2ND=b3 CLK_DIS=b4 SRAM_PDN=b8
+ *   CONN bus-prot release (vendor order):
+ *     PROTECTEN_CLR   = STEP2_0 = b14        (0x4000)
+ *     PROTECTEN_1_CLR = STEP2_1 = b10        (0x0400)
+ *     PROTECTEN_CLR   = STEP1_0 = b13|b18    (0x42000)
+ *   CONN_PROT step masks verified in clk-mt6853-pg.c lines 249-256.
+ *
+ * This is only a silicon probe: iOS has no IO80211Family / IOBluetoothFamily
+ * stack for a MediaTek MAC, so functional Wi-Fi/BT needs a user-mode or
+ * kernel stack that does not exist yet (documented in NOTES.md).  The probe
+ * proves power/reset/PMU rails are right so later work has a foundation.
+ * Behind sweetconn=1 (default off).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_conn_init(void);
+
+#define CONN_SPM_PA     0x10006000u
+#define CONN_INFRA_PA   0x10001000u
+#define CONN_MCU_PA     0x18002000u /* CONN_MCU_CONFIG_BASE per consys node */
+
+#define SP_PWR_STATUS   0x016cu
+#define SP_PWR_STATUS_2 0x0170u
+#define SP_CONN_CON     0x0304u
+#define PWC_RST_B       (1u << 0)
+#define PWC_ISO         (1u << 1)
+#define PWC_ON          (1u << 2)
+#define PWC_ON_2ND      (1u << 3)
+#define PWC_CLK_DIS     (1u << 4)
+#define PWC_SRAM_PDN    (1u << 8)
+#define PWC_SRAM_ACK    (1u << 12)
+#define STA_CONN        (1u << 1)
+
+#define PROTEN_CLR      0x02a4u
+#define PROTEN_1_CLR    0x02acu
+
+#define CONNSYS_HW_IP_VER 0x0110u
+
+static vm_offset_t c_spm, c_infra, c_mcu;
+
+static uint32_t
+crd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+cwr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+conn_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+
+	/* power on CONN domain (vendor order) */
+	uint32_t v = crd(c_spm, SP_CONN_CON);
+	cwr(c_spm, SP_CONN_CON, v | PWC_ON);
+	cwr(c_spm, SP_CONN_CON, crd(c_spm, SP_CONN_CON) | PWC_ON_2ND);
+	int ok = 0;
+	for (int i = 0; i < 20000; ++i) {
+		if ((crd(c_spm, SP_PWR_STATUS) & STA_CONN) &&
+		    (crd(c_spm, SP_PWR_STATUS_2) & STA_CONN)) { ok = 1; break; }
+		delay(1);
+	}
+	if (!ok) {
+		printf("SWEET CONN: power-on timeout con=%#x sta=%#x/%#x\n",
+		    crd(c_spm, SP_CONN_CON), crd(c_spm, SP_PWR_STATUS),
+		    crd(c_spm, SP_PWR_STATUS_2));
+		goto out;
+	}
+	cwr(c_spm, SP_CONN_CON, crd(c_spm, SP_CONN_CON) & ~PWC_CLK_DIS);
+	cwr(c_spm, SP_CONN_CON, crd(c_spm, SP_CONN_CON) & ~PWC_ISO);
+	cwr(c_spm, SP_CONN_CON, crd(c_spm, SP_CONN_CON) | PWC_RST_B);
+	printf("SWEET CONN: domain on\n");
+
+	/* release CONN bus protect (vendor order) */
+	cwr(c_spm, SP_CONN_CON, crd(c_spm, SP_CONN_CON) & ~PWC_SRAM_PDN);
+	for (int i = 0; i < 20000 && (crd(c_spm, SP_CONN_CON) & PWC_SRAM_ACK); ++i)
+		delay(1);
+	cwr(c_infra, PROTEN_CLR,   0x00004000u); /* STEP2_0 b14      */
+	cwr(c_infra, PROTEN_1_CLR, 0x00000400u); /* STEP2_1 b10      */
+	cwr(c_infra, PROTEN_CLR,   0x00042000u); /* STEP1_0 b13|b18  */
+	printf("SWEET CONN: bus prot released\n");
+
+	/* read the conninfra hardware IP version */
+	delay(1000);
+	uint32_t ip = crd(c_mcu, CONNSYS_HW_IP_VER);
+	printf("SWEET CONN: CONNSYS_HW_IP_VER=%#08x\n", ip);
+	printf("SWEET CONN: note - iOS has no wlan/bt stack for this MAC; "
+	    "probe only proves power path (see NOTES.md)\n");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_conn_init(void)
+{
+	static int started;
+	int enabled = 0;
+	thread_t thread;
+	if (started)
+		return;
+	started = 1;
+	(void)PE_parse_boot_argn("sweetconn", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET CONN: off (sweetconn=1 to probe conninfra)\n");
+		return;
+	}
+	c_spm = ml_io_map(CONN_SPM_PA, 0x1000);
+	c_infra = ml_io_map(CONN_INFRA_PA, 0x1000);
+	c_mcu = ml_io_map(CONN_MCU_PA, 0x1000);
+	if (!c_spm || !c_infra || !c_mcu) {
+		printf("SWEET CONN: MMIO map failed\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(conn_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS)
+		thread_deallocate(thread);
+	else
+		printf("SWEET CONN: kernel_thread_start failed %d\n", kr);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
