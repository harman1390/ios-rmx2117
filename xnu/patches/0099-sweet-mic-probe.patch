--- /dev/null
+++ b/bsd/dev/sweet_mic.c
@@ -0,0 +1,163 @@
+/*
+ * SWEET mic/audio probe for RMX2117 (MT6853) -- probe level only.
+ *
+ * The audio codec lives inside the MT6359P PMIC; its digital blocks
+ * are read/written over pwrap SWINF_2 (serialised by sweet_pwrap_lock).
+ * Vendor register refs: include/linux/mfd/mt6359p/registers.h,
+ * drivers/iio/adc/mt635x-auxadc.c, sound/soc/mediatek/mt6853/.
+ *
+ *   AUD_TOP block (0x2300+):
+ *     AUD_TOP_CKPDN_CON0 0x230c / _SET 0x230e / _CLR 0x2310
+ *     AUD_TOP_CKSEL_CON0 0x2312
+ *     AUDIO_DIG_DSN_ID   0x2380   -- digital codec ID readback
+ *     AFE_UL_DL_CON0     0x2388   -- uplink/downlink path enable
+ *   AUDENC block (0x2500+):
+ *     AUDENC_DSN_ID      0x2500   -- uplink ADC (mic path) design ID
+ *
+ * AP side: AFE MMIO @0x11210000 (mediatek,mt6853-afe-pcm / audiosys_clk
+ * syscon in mt6853-src.dts).  Probe reads the AFE SRAM/version window.
+ *
+ * This proves the codec is alive and the AP-side AFE is reachable;
+ * an actual capture path (mic bias + ADCUL + AFE DMA + an iOS Audio
+ * HAL that does not exist yet) is the documented follow-on.
+ *
+ * Boot-arg: sweetmic=1 (default off).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_pwrap_lock(void);
+extern void sweet_pwrap_unlock(void);
+void sweet_mic_init(void);
+
+#define MIC_PWRAP_PA  0x10026000u
+#define MIC_AFE_PA    0x11210000u  /* mt6853-afe / audiosys */
+
+#define PWRAP_ACC    0x0c80u
+#define PWRAP_WDATA  0x0c84u
+#define PWRAP_RDATA  0x0c94u
+#define PWRAP_VLDCLR 0x0ca4u
+#define PWRAP_STA    0x0ca8u
+#define PWRAP_FSM(x) (((x) >> 1) & 7u)
+#define PWRAP_IDLE   0u
+#define PWRAP_WFVLD  6u
+
+#define AUD_CKPDN_CLR  0x2310u  /* write1->clear clock-gates */
+#define AUD_DIG_DSN    0x2380u
+#define AUD_ULDL_CON0  0x2388u
+#define AUDENC_DSN     0x2500u
+
+static vm_offset_t g_pwrap, g_afe;
+static int g_started;
+
+static uint32_t
+r32(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+w32(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int
+pwait(uint32_t want)
+{
+	for (int i = 0; i < 1000; ++i) {
+		if (PWRAP_FSM(r32(g_pwrap, PWRAP_STA)) == want)
+			return 0;
+		delay(1);
+	}
+	return -1;
+}
+
+static int
+pmic_r(uint32_t adr, uint32_t *out)
+{
+	if (pwait(PWRAP_IDLE)) {
+		if (PWRAP_FSM(r32(g_pwrap, PWRAP_STA)) == PWRAP_WFVLD)
+			w32(g_pwrap, PWRAP_VLDCLR, 1);
+		return -1;
+	}
+	w32(g_pwrap, PWRAP_ACC, adr);
+	if (pwait(PWRAP_WFVLD))
+		return -2;
+	*out = r32(g_pwrap, PWRAP_RDATA) & 0xffffu;
+	w32(g_pwrap, PWRAP_VLDCLR, 1);
+	return 0;
+}
+
+static int
+pmic_w(uint32_t adr, uint32_t v)
+{
+	if (pwait(PWRAP_IDLE))
+		return -1;
+	w32(g_pwrap, PWRAP_WDATA, v & 0xffffu);
+	w32(g_pwrap, PWRAP_ACC, (1u << 29) | adr);
+	return pwait(PWRAP_IDLE) ? -2 : 0;
+}
+
+static void
+mic_thread(void *arg, wait_result_t result)
+{
+	uint32_t v = 0, d = 0, e = 0;
+	(void)arg;
+	(void)result;
+
+	sweet_pwrap_lock();
+	/* ungate the audio digital clocks (vendor: CKPDN_CON0_CLR) */
+	int ok = (pmic_w(AUD_CKPDN_CLR, 0xffff) == 0);
+	ok &= (pmic_r(AUD_DIG_DSN, &v) == 0);
+	ok &= (pmic_r(AUDENC_DSN, &d) == 0);
+	ok &= (pmic_r(AUD_ULDL_CON0, &e) == 0);
+	sweet_pwrap_unlock();
+	printf("SWEET MIC: codec dsn=%#x audenc dsn=%#x uldl=%#x (%s)\n",
+	    v, d, e, ok ? "alive" : "NO PMIC CODEC RESPONSE");
+
+	/* AP-side AFE: audsys is clock-gated in audiosys_clk CGs; read the
+	 * CG state and the AFE version/SRAM window to prove reachability */
+	printf("SWEET MIC: afe @11210000 reads %08x %08x %08x %08x\n",
+	    r32(g_afe, 0x00), r32(g_afe, 0x04),
+	    r32(g_afe, 0x08), r32(g_afe, 0x0c));
+	if (ok && (v || d))
+		printf("SWEET MIC: mic codec path reachable "
+		    "(full capture = follow-on)\n");
+}
+
+void
+sweet_mic_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (g_started)
+		return;
+	g_started = 1;
+	(void)PE_parse_boot_argn("sweetmic", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET MIC: off (sweetmic=1 to probe)\n");
+		return;
+	}
+	g_pwrap = ml_io_map(MIC_PWRAP_PA, 0x1000);
+	g_afe = ml_io_map(MIC_AFE_PA, 0x1000);
+	if (!g_pwrap || !g_afe) {
+		printf("SWEET MIC: map failed\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(mic_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS)
+		thread_deallocate(thread);
+	else
+		printf("SWEET MIC: thread failed %d\n", kr);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
