+/*
+ * SWEET keys for MediaTek MT6853 (RMX2117 / Narzo 30 Pro 5G).
+ *
+ * Real device config recovered from the board's dtbo overlay:
+ *   volume-down = GPIO80 / EINT80  (kpd_volume_down, VOLUME_DOWN-eint)
+ *   volume-up   = GPIO1  / EINT1   (kpd_volume_up,   VOLUME_UP-eint)
+ *   power/home  = MT6359 PMIC keys (pwrkey/homekey on mediatek,mt6359-pmic)
+ *
+ * The volume keys are declared as "gpio-eint" pinctrl states, but the pinmux
+ * selects the GPIO function (func0) on both pins, so they read as plain GPIO
+ * inputs via the DIN latch at 0x10005000+0x200 -- not via the EINT block.
+ *
+ * vol-down (GPIO80) already reads via DIN. GPIO1 (vol-up) does not; the
+ * working hypothesis is missing input-enable/pull, so this sets, in iocfg_br
+ * (0x11D40000) set IES@0x0070b12 (input enable), PU@0x00b0b12 (pull-up), and
+ * clear PD@0x0090b12 (pull-down) -- all three fields vendor-verified against
+ * pinctrl-mt6853.c (mt6853_pin_{ies,pu,pd}_range: pin1 -> base5(iocfg_br),
+ * 0x70/0xb0/0x90 bit12). Then it polls GPIO DIN and fires sweet_hid_key on
+ * transitions.
+ *
+ * The stock PMIC config also wires a "homekey" line (mt-pmic interrupts
+ * pwrkey/pwrkey_r/homekey/homekey_r; this phone has no physical home button,
+ * so homekey is the classic realme vol-up-to-PMIC wire). Because the dtbo's
+ * GPIO1 claim could not be proven, BOTH candidate lines are polled for
+ * vol-up: GPIO1 DIN and the MT6359 HOMEKEY_DEB bit. Each line must be seen
+ * released at least once before its presses count ("armed"), so a line that
+ * reads permanently-low (wrong pad, floating) can never fake a press.
+ *
+ * Power is the MT6359 PWRKEY. The DTB places mt6359-pmic under
+ * pwrap@10026000 (mediatek,mt6853-pwrap), so TOPSTATUS (0x2a) is read via
+ * the AP software channel SWINF_2 using the vendor ARB_V3 sequence:
+ * wait STA FSM idle, ACC=addr, wait FSM WFVLDCLR, read RDATA, VLD_CLR=1.
+ * pressed = !(TOPSTATUS & 0x2) as in mtk-pmic-keys.c; homekey = !(TOPSTATUS
+ * & 0x8) per the upstream mt6359_regs table (0x2/0x8 deb bits at 0x2a).
+ *
+ * sweet_hid_key indices: 0=power, 1=vol-up, 2=vol-down.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+void sweet_keys_init(void);
+
+#define KEYS_GPIO_PA        0x10005000u
+#define KEYS_IOC_BR_PA      0x11D40000u
+#define KEYS_PWRAP_PA       0x10026000u
+
+/* MT6853 PMIF-SPI SWINF_2 (vendor mt6853_regs). */
+#define PWRAP_ACC           0xC80u
+#define PWRAP_RDATA         0xC94u
+#define PWRAP_VLD_CLR       0xCA4u
+#define PWRAP_STA           0xCA8u
+#define PWRAP_FSM(x)        (((x) >> 1) & 0x7u)
+#define PWRAP_FSM_IDLE      0x0u
+#define PWRAP_FSM_WFVLDCLR  0x6u
+
+#define MT6359_TOPSTATUS    0x02au
+#define MT6359_PWRKEY_DEB   0x2u
+#define MT6359_HOMEKEY_DEB  0x8u
+
+/* MT6853 GPIO DIN: bank n register at 0x0200 + n*0x10, one bit per pin. */
+#define KEYS_DIN_OFF(pin)   (0x0200u + ((pin) / 32u) * 0x10u)
+#define KEYS_DIN_BIT(pin)   (1u << ((pin) & 31u))
+
+#define KEY_PWR             0
+#define KEY_VOLUP           1
+#define KEY_VOLDN           2
+
+#define PIN_VOLUP           1u
+#define PIN_VOLDN           80u
+
+static vm_offset_t keys_gpio;
+static vm_offset_t keys_ioc1;
+static vm_offset_t keys_pwrap;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+key_din(unsigned pin)
+{
+	uint32_t v = *(volatile uint32_t *)(keys_gpio + KEYS_DIN_OFF(pin));
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return (v >> (pin & 31u)) & 1u;
+}
+
+/* Configure GPIO1 (vol-up) as a readable input: GPIO func, input dir, input
+ * enable (IES) and pull-up (PU) in iocfg_br. Field offsets/bits are the
+ * vendor pinctrl-mt6853.c pin_field tables, not guesses. */
+static void
+keys_cfg_volup(void)
+{
+	volatile uint32_t *mode = (volatile uint32_t *)(keys_gpio + 0x0300 + (PIN_VOLUP / 8u) * 0x10u);
+	volatile uint32_t *dir  = (volatile uint32_t *)(keys_gpio + 0x0000 + (PIN_VOLUP / 32u) * 0x10u);
+	volatile uint32_t *ioc  = (volatile uint32_t *)keys_ioc1;
+	if (!ioc)
+		return;
+	*mode &= ~(0xFu << ((PIN_VOLUP & 7u) * 4u)); /* func0 = GPIO */
+	*dir  &= ~(1u << (PIN_VOLUP & 31u));         /* dir = input */
+	ioc[0x0070 / 4] |=  (1u << 12);              /* IES = input enable */
+	ioc[0x00b0 / 4] |=  (1u << 12);              /* PU  = pull-up */
+	ioc[0x0090 / 4] &= ~(1u << 12);              /* PD  = pull-down off */
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint32_t
+pwrap_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(keys_pwrap + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+pwrap_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(keys_pwrap + off) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int
+pwrap_wait(uint32_t want)
+{
+	for (int i = 0; i < 1000; ++i) {
+		if (PWRAP_FSM(pwrap_rd(PWRAP_STA)) == want)
+			return 0;
+		delay(1);
+	}
+	return -1;
+}
+
+static int
+pmic_read16(uint32_t adr, uint32_t *out)
+{
+	if (pwrap_wait(PWRAP_FSM_IDLE)) {
+		if (PWRAP_FSM(pwrap_rd(PWRAP_STA)) == PWRAP_FSM_WFVLDCLR)
+			pwrap_wr(PWRAP_VLD_CLR, 1);
+		return -1;
+	}
+	pwrap_wr(PWRAP_ACC, adr);
+	if (pwrap_wait(PWRAP_FSM_WFVLDCLR))
+		return -2;
+	*out = pwrap_rd(PWRAP_RDATA) & 0xffffu;
+	pwrap_wr(PWRAP_VLD_CLR, 1);
+	return 0;
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	int vdn_state = 0, vdn_cand = 0, vdn_cnt = 0;
+	int vu_state[2] = { 0, 0 }, vu_cand[2] = { 0, 0 };
+	int vu_cnt[2] = { 0, 0 }, vu_armed[2] = { 0, 0 };
+	int pwr = 0, pwr_err = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		/* Active-low keys; report after 3 equal samples (~30 ms). */
+		int p = !key_din(PIN_VOLDN);
+		if (p != vdn_cand) {
+			vdn_cand = p;
+			vdn_cnt = 0;
+		} else if (p != vdn_state && ++vdn_cnt >= 3) {
+			vdn_state = p;
+			printf("KEYGPIO pin=%u %s\n", PIN_VOLDN, p ? "down" : "up");
+			sweet_hid_key(KEY_VOLDN, p);
+		}
+
+		/* Vol-up candidate lines: 0 = GPIO1 DIN, 1 = PMIC HOMEKEY.
+		 * A line arms only after it has been seen released, so a
+		 * permanently-low wrong pad can never emit a press. */
+		uint32_t st = 0;
+		int pm_ok = (keys_pwrap && pwr_err < 50 &&
+		    pmic_read16(MT6359_TOPSTATUS, &st) == 0);
+		int vu_line[2];
+		vu_line[0] = !key_din(PIN_VOLUP);
+		vu_line[1] = pm_ok ? !(st & MT6359_HOMEKEY_DEB) : vu_state[1];
+		for (int s = 0; s < 2; ++s) {
+			p = vu_line[s];
+			if (!p)
+				vu_armed[s] = 1;
+			if (p != vu_cand[s]) {
+				vu_cand[s] = p;
+				vu_cnt[s] = 0;
+			} else if (vu_armed[s] && p != vu_state[s] && ++vu_cnt[s] >= 3) {
+				vu_state[s] = p;
+				printf("KEYVU src=%d %s\n", s, p ? "down" : "up");
+				sweet_hid_key(KEY_VOLUP, p);
+			}
+		}
+
+		if (pm_ok) {
+			p = !(st & MT6359_PWRKEY_DEB);
+			if (p != pwr) {
+				pwr = p;
+				printf("KEYPMIC pwrkey=%d topstatus=%#x\n", p, st);
+				sweet_hid_key(KEY_PWR, p);
+			}
+		} else if (keys_pwrap && ++pwr_err == 50) {
+			printf("SWEET KEYS: pwrap reads failing, power+homekey disabled\n");
+		}
+		keys_wait();
+	}
+}
+
+void
+sweet_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	keys_gpio = ml_io_map(KEYS_GPIO_PA, 0x2000);
+	if (!keys_gpio) {
+		printf("SWEET KEYS: GPIO MMIO map failed\n");
+		return;
+	}
+	keys_ioc1 = ml_io_map(KEYS_IOC_BR_PA, 0x1000);
+	if (!keys_ioc1)
+		printf("SWEET KEYS: iocfg_br map failed (vol-up pull off)\n");
+	keys_cfg_volup();
+	keys_pwrap = ml_io_map(KEYS_PWRAP_PA, 0x1000);
+	if (!keys_pwrap)
+		printf("SWEET KEYS: pwrap map failed (no power key)\n");
+	printf("SWEET KEYS: volup=GPIO1+HOMEKEY voldn=GPIO80, din1=%d din80=%d\n",
+	    key_din(PIN_VOLUP), key_din(PIN_VOLDN));
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- /dev/null
+++ b/bsd/dev/sweet_touch.c
@@ -0,0 +1,1133 @@
+/*
+ * SWEET MT6853 SPI4 / Novatek NT36672C (oplus tp_noflash) touch bring-up.
+ * RMX2117 wiring from the stock DTBO: spi4@11018000, irq GPIO14, reset
+ * GPIO33, SPI pins GPIO12=MI, GPIO13=MO, GPIO97=CLK, GPIO98=CSB (func2).
+ * CS is bit-banged on GPIO98: the engine deasserts CSB at every ACT
+ * boundary, so hardware CS would split each >32-byte NVT message
+ * (256-byte fw page writes, 80-byte point reads) into separate CS
+ * windows.  Manual CS keeps one window across all FIFO chunks.
+ * NT36672C is a "noflash" TDDI: SRAM firmware must be host-downloaded on
+ * every boot, mirroring Download_Firmware_HW_CRC() in the OPLUS
+ * nvt_drivers_nt36672c_noflash.c vendor driver (FW_NF_NT36672C_JDI.img).
+ * Wire format (vendor touch_interfaces.c): write = offset|0x80 then data;
+ * read  = offset&0x7f then one dummy MISO byte then data.  An earlier
+ * version sent writes without the 0x80 flag (silently dropped) and
+ * skipped the read dummy byte (all reads shifted one byte), which is why
+ * the chip-id probe could never match.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void *kernel_pmap;
+extern unsigned int pmap_find_phys(void *pmap, unsigned long long va);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_touch_init(void);
+
+/* --- MT6853 hardware ------------------------------------------------- */
+#define TP_SPI4_PA      0x11018000u /* spi4 */
+#define TP_GPIO_PA      0x10005000u /* gpio block: dir/din/dout/mode */
+#define TP_INFRA_PA     0x10001000u /* infracfg_ao: peripheral CG */
+#define TP_IOC_LM       0x11E20000u /* iocfg_lm (ibase6): pins 12,13,97,98 */
+#define TP_IOC_BM       0x11D10000u /* iocfg_bm (ibase3): pin 43 */
+#define TP_IOC_TL       0x11F30000u /* iocfg_tl (ibase8): pin 14 */
+
+#define TP_SPI4_CG_CLR  0xa8u       /* IFRAO4 gate clear, SPI4 = bit25 */
+#define TP_SPI4_CG_STA  0xacu
+#define TP_SPI4_CG_BIT  (1u << 25)
+
+/* spi-mt65xx register offsets */
+#define SPI_CFG0        0x00u
+#define SPI_CFG1        0x04u
+#define SPI_TXD         0x10u
+#define SPI_RXD         0x14u
+#define SPI_CMD         0x18u
+#define SPI_ST0         0x1cu
+#define SPI_ST1         0x20u
+#define SPI_PADSEL      0x24u
+#define SPI_CFG2        0x28u
+/* CMD bits */
+#define SPI_ACT         (1u << 0)
+#define SPI_RESUME      (1u << 1)
+#define SPI_RST         (1u << 2)
+#define SPI_PAUSE_EN    (1u << 4)
+#define SPI_TXMSBF      (1u << 12)
+#define SPI_RXMSBF      (1u << 13)
+#define SPI_FINISH_IE   (1u << 16)
+#define SPI_PAUSE_IE    (1u << 17)
+/* ST0: bit0 = finish-int, bit1 = pause-int (vendor spi-mt65xx irq) */
+#define SPI_ST0_FINISH  1u
+#define SPI_ST0_PAUSE   2u
+
+#define SPI_FIFO        32u
+/* dma regs (spi-mt65xx.c SPI_TX_SRC_REG etc; mt6853 supports 36b dma) */
+#define SPI_TX_SRC        0x08u
+#define SPI_RX_DST        0x0cu
+#define SPI_TX_SRC_64     0x2cu
+#define SPI_RX_DST_64     0x30u
+#define SPI_CMD_RX_DMA    (1u << 10)
+#define SPI_CMD_TX_DMA    (1u << 11)
+
+/* GPIO block (all pins, ibase0) */
+#define TP_DIR(pin)     (0x0000u + ((pin) / 32u) * 0x10u)
+#define TP_DOUT(pin)    (0x0100u + ((pin) / 32u) * 0x10u)
+#define TP_DIN(pin)     (0x0200u + ((pin) / 32u) * 0x10u)
+#define TP_MODE(pin)    (0x0300u + ((pin) / 8u) * 0x10u)
+
+/* pins */
+#define TP_PIN_MI       12u   /* SPI4_MI  */
+#define TP_PIN_MO       13u   /* SPI4_MO  */
+#define TP_PIN_CLK      97u   /* SPI4_CLK */
+#define TP_PIN_CSB      98u   /* SPI4_CSB -> used as manual CS GPIO */
+#define TP_PIN_IRQ      14u
+#define TP_PIN_RST      33u   /* RMX2117 project 20611 touch node */
+#define TP_PIN_RST2     43u   /* alternate overlay variant */
+#define TP_PIN_SCL      107u        /* SCL5 */
+#define TP_PIN_SDA      108u        /* SDA5 */
+#define TP_I2C_FUNC     1u
+
+/* --- MT6360 sub-PMIC on i2c5 -------------------------------------------
+ * mt_pmic_vtp_ldo_reg is LDO2 ("VTP") of the sub-PMIC.  NOTE: the project
+ * 20611 touchscreen node wires NO supply -- the incell TDDI is powered
+ * through the panel bias, which LK already turned on.  vdd_2v8->VTP is
+ * only declared on other projects (20630/20637).  This block is therefore
+ * OPT-IN (sweetvtp=1): without it we never touch i2c5, avoiding both a
+ * wrong rail and MMIO to a possibly clock-gated controller. */
+#define TP_I2C5_PA      0x11d00000u /* i2c5 controller */
+#define TP_I2C5_DMA_PA  0x10217500u /* DMA/reset resource from live i2c5 DT */
+#define TP_IMPIIC_PA    0x11d04000u /* imp_iic_wrap_s clk gate: sta e00/clr e04 */
+#define TP_IMPIIC_I2C5  (1u << 0)   /* CLK_IMPS_AP_CLOCK_RO_I2C5 */
+#define MT6360_ADDR     0x64u       /* subpmic_ldo, i2c-5 slave 0x64 (unverified) */
+#define MT6360_LDO2_EN  0x11u       /* EN_CTRL2: bit6 enables LDO2 */
+#define MT6360_LDO2_VSEL 0x15u      /* CTRL3: 0xba = 3.1 V (flat range) */
+
+/* topckgen spi_sel mux (clk-mt6853): CLK_CFG_6 bits[17:16], upd bit26 */
+#define TP_TOPCK_PA     0x10000000u
+#define TP_CLK_CFG6     0x070u
+#define TP_CLK_CFG6_SET 0x074u
+#define TP_CLK_CFG6_CLR 0x078u
+#define TP_CLK_CFG_UPD  0x004u
+#define TP_SPI_SEL_LSB  16u
+#define TP_MUX_SPI_UPD  (1u << 26)
+
+/* --- NT36672C constants (NT36675 mmap) ------------------------------- */
+#define NVT_EVENT_BUF   0x22D00u
+#define NVT_SWRST_N8    0x03F0FEu
+#define NVT_ENG_RST     0x7FFF80u
+#define NVT_BOOT_RDY    0x03F10Du
+#define NVT_BLD_CRC_EN  0x03F30Eu
+#define NVT_ILM_DES     0x03F128u
+#define NVT_ILM_LEN     0x03F118u
+#define NVT_DLM_DES     0x03F12Cu
+#define NVT_DLM_LEN     0x03F130u
+#define NVT_G_ILM_CHK   0x03F100u
+#define NVT_G_DLM_CHK   0x03F104u
+#define NVT_CHIP_PAGE   0x1F600u
+#define NVT_CHIP_OFF    0x4Eu
+/* event buffer map */
+#define NVT_EV_HOST_CMD 0x50u
+#define NVT_EV_RST_DONE 0x60u
+#define NVT_EV_FWINFO   0x78u
+#define NVT_EV_PROJID   0x9Au
+/* reset states */
+#define NVT_ST_INIT     0xA0u
+#define NVT_ST_NORMAL   0xA3u
+#define NVT_ST_MAX      0xAFu
+
+#define NVT_POINT_LEN   78u   /* POINT_DATA_LEN */
+#define NVT_XFER_LEN    256u  /* SPI_TANSFER_LENGTH */
+#define TP_TOUCH_MAX    10u
+
+extern const unsigned char sweet_nvt_fw[];
+extern const unsigned int sweet_nvt_fw_size;
+
+static struct {
+	vm_offset_t spi, gpio, infra, lm, bm, tl, i2c, i2c_dma, topck, impiic;
+	bool started, dead, have_nvt;
+	uint32_t active;
+	int x[TP_TOUCH_MAX], y[TP_TOUCH_MAX];
+} st;
+static int touch_sleep_chan;
+
+static uint32_t
+trd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+twr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+twait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* --- GPIO helpers ---------------------------------------------------- */
+static void
+gpio_mode(unsigned pin, unsigned func)
+{
+	uint32_t off = TP_MODE(pin), shift = (pin % 8u) * 4u;
+	twr(st.gpio, off, (trd(st.gpio, off) & ~(0xfu << shift)) | (func << shift));
+}
+
+static void
+gpio_dir(unsigned pin, bool out)
+{
+	uint32_t off = TP_DIR(pin), bit = 1u << (pin % 32u);
+	twr(st.gpio, off, out ? (trd(st.gpio, off) | bit) : (trd(st.gpio, off) & ~bit));
+}
+
+static void
+gpio_out(unsigned pin, bool hi)
+{
+	uint32_t off = TP_DOUT(pin), bit = 1u << (pin % 32u);
+	twr(st.gpio, off, hi ? (trd(st.gpio, off) | bit) : (trd(st.gpio, off) & ~bit));
+}
+
+static bool
+gpio_in(unsigned pin)
+{
+	return (trd(st.gpio, TP_DIN(pin)) >> (pin % 32u)) & 1u;
+}
+
+/* --- i2c5 (vendor mtk controller, 16-bit regs) ------------------------ */
+#define I2C_REG_DATA      0x00u
+#define I2C_REG_SLAVE     0x04u
+#define I2C_REG_ISTAT     0x0cu
+#define I2C_REG_CONTROL   0x10u
+#define I2C_REG_XFER_LEN  0x14u
+#define I2C_REG_TRANS_LEN 0x18u
+#define I2C_REG_DELAY     0x1cu
+#define I2C_REG_TIMING    0x20u
+#define I2C_REG_START     0x24u
+#define I2C_REG_EXT_CONF  0x28u
+#define I2C_REG_FIFO_CLR  0x38u
+#define I2C_REG_IOCFG     0x40u
+#define I2C_REG_HS        0x48u
+#define I2C_REG_SOFTRST   0x50u
+#define I2C_REG_DCM_EN    0x54u
+#define I2C_REG_XFER_AUX  0x6cu
+#define I2C_CTL_RS        0x02u
+#define I2C_CTL_CLK_EXT   0x08u
+#define I2C_CTL_DIR_CHG   0x10u
+#define I2C_CTL_ACKERR    0x20u
+
+static uint16_t
+i2cr(uint32_t off)
+{
+	return *(volatile uint16_t *)(st.i2c + off);
+}
+
+static void
+i2cw(uint32_t off, uint16_t v)
+{
+	*(volatile uint16_t *)(st.i2c + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* MT6360 i2c frames carry a crc8(0x07) over (addr<<1)|reg|data */
+static uint8_t
+crc8_07(const uint8_t *d, unsigned n)
+{
+	uint8_t c = 0;
+	while (n--) {
+		c ^= *d++;
+		for (int i = 0; i < 8; i++)
+			c = (c & 0x80u) ? (uint8_t)((c << 1) ^ 0x07u) : (uint8_t)(c << 1);
+	}
+	return c;
+}
+
+/* one transaction, optional read phase (RS+DIR_CHANGE). returns ISTAT. */
+static uint16_t
+i2c5_xfer(uint8_t addr, const uint8_t *wr, unsigned wlen, uint8_t *rd, unsigned rlen)
+{
+	uint16_t ctl = I2C_CTL_ACKERR | I2C_CTL_CLK_EXT;
+	unsigned i, spins = 200000;
+	uint16_t s = 0;
+	if (rlen)
+		ctl |= I2C_CTL_DIR_CHG | I2C_CTL_RS;
+	else
+		i2cw(I2C_REG_DELAY, 0x0002);
+	i2cw(I2C_REG_CONTROL, ctl);
+	i2cw(I2C_REG_SLAVE, (uint16_t)(addr << 1));
+	i2cw(I2C_REG_ISTAT, 0x0007);
+	i2cw(I2C_REG_FIFO_CLR, 0x0001);
+	i2cw(I2C_REG_XFER_LEN, (uint16_t)wlen);
+	i2cw(I2C_REG_XFER_AUX, (uint16_t)rlen);
+	i2cw(I2C_REG_TRANS_LEN, rlen ? 0x0002u : 0x0001u);
+	for (i = 0; i < wlen; i++)
+		i2cw(I2C_REG_DATA, wr[i]);
+	i2cw(I2C_REG_START, 0x0001);
+	while (spins-- && !((s = i2cr(I2C_REG_ISTAT)) & 0x0007))
+		;
+	for (i = 0; rd && i < rlen; i++)
+		rd[i] = (uint8_t)i2cr(I2C_REG_DATA);
+	return s;
+}
+
+static int
+mt6360_wr(uint8_t reg, uint8_t val)
+{
+	uint8_t f[4] = { reg & 0x3fu, val, 0, 0 };
+	uint8_t c[3] = { (uint8_t)(MT6360_ADDR << 1), f[0], f[1] };
+	f[2] = crc8_07(c, 3);
+	return (i2c5_xfer(MT6360_ADDR, f, 4, NULL, 0) & 0x0007u) == 0x0001u ? 0 : -EIO;
+}
+
+static int
+mt6360_rd(uint8_t reg)
+{
+	uint8_t f[1] = { reg & 0x3fu };
+	uint8_t out[2] = { 0, 0 };
+	uint8_t c[3];
+	uint16_t s = i2c5_xfer(MT6360_ADDR, f, 1, out, 2);
+	if ((s & 0x0007u) != 0x0001u) {
+		printf("SWEET TOUCH: i2c5 rd reg=%#x failed istat=%#x\n", reg, s);
+		return -1;
+	}
+	/* crck = crc8(addr_r | reg | val) */
+	c[0] = (uint8_t)((MT6360_ADDR << 1) | 1);
+	c[1] = f[0];
+	c[2] = out[0];
+	if (crc8_07(c, 3) != out[1]) {
+		printf("SWEET TOUCH: i2c5 rd reg=%#x crc bad val=%#x crck=%#x\n",
+		    reg, out[0], out[1]);
+		return -1;
+	}
+	return out[0];
+}
+
+/* Opt-in VTP LDO2 bring-up (sweetvtp=1).  Project 20611 wires no TP
+ * supply, so the rail is probably unused here; keep it available for
+ * experiments.  Ungate the imp i2c5 bus clock before any MMIO. */
+static void
+vtp_power_on(void)
+{
+	twr(st.impiic, 0xe04, TP_IMPIIC_I2C5); /* CG clr */
+	printf("SWEET TOUCH: i2c5 imp cg sta=%#x\n",
+	    trd(st.impiic, 0xe00));
+	gpio_mode(TP_PIN_SCL, TP_I2C_FUNC);
+	gpio_mode(TP_PIN_SDA, TP_I2C_FUNC);
+	i2cw(I2C_REG_START, 0x0000); /* clear the I2C channel before reset */
+	*(volatile uint32_t *)(st.i2c_dma + 0x0c) = 0x0002; /* DMA hard reset */
+	__asm__ volatile("dsb osh" ::: "memory");
+	delay(50);
+	*(volatile uint32_t *)(st.i2c_dma + 0x0c) = 0;
+	__asm__ volatile("dsb osh" ::: "memory");
+	i2cw(I2C_REG_SOFTRST, 0x0001);
+	delay(50);
+	i2cw(I2C_REG_DCM_EN, 0x0000);
+	i2cw(I2C_REG_IOCFG, 0x0000);  /* stock i2c5 DT sets mediatek,use-push-pull */
+	i2cw(I2C_REG_HS, 0x0000);
+	i2cw(I2C_REG_EXT_CONF, 0x1800); /* FS start condition */
+	i2cw(I2C_REG_TIMING, 0x073f);   /* ~150 kHz, conservative for the pmic */
+	int en = mt6360_rd(MT6360_LDO2_EN);
+	int vs = mt6360_rd(MT6360_LDO2_VSEL);
+	printf("SWEET TOUCH: vtp ldo2 before en=%#x vsel=%#x\n", en, vs);
+	if (en < 0 || vs < 0) {
+		printf("SWEET TOUCH: cannot read vtp LDO2 state; leaving PMIC unchanged\n");
+		return;
+	}
+	if ((vs & 0x3f) != 0xba && mt6360_wr(MT6360_LDO2_VSEL, 0xbau) != 0) {
+		printf("SWEET TOUCH: vtp LDO2 voltage write failed\n");
+		return;
+	}
+	if (!(en & 0x40) && mt6360_wr(MT6360_LDO2_EN, (uint8_t)(en | 0x40u)) != 0) {
+		printf("SWEET TOUCH: vtp LDO2 enable write failed\n");
+		return;
+	}
+	twait(10); /* vendor power-on-delay-us = 10000 */
+	en = mt6360_rd(MT6360_LDO2_EN);
+	vs = mt6360_rd(MT6360_LDO2_VSEL);
+	printf("SWEET TOUCH: vtp ldo2 after en=%#x vsel=%#x\n", en, vs);
+	if (en < 0 || vs < 0 || !(en & 0x40) || (vs & 0x3f) != 0xba)
+		printf("SWEET TOUCH: vtp LDO2 state did not verify\n");
+}
+
+/* --- SPI4 ------------------------------------------------------------ */
+static bool
+spi_config(void)
+{
+	/* Keep LK's spi_sel parent: the previous build forced idx0 on the
+	 * assumption it was the 26 MHz xtal -- unverified, and a dead mux
+	 * parent starves the shift clock exactly like the st1=0x1 busy
+	 * stalls we keep seeing. Just log what LK left. */
+	uint32_t cfg6 = trd(st.topck, TP_CLK_CFG6);
+	printf("SWEET TOUCH: spi_sel mux cfg6=%#x (idx=%u)\n",
+	    cfg6, (cfg6 >> TP_SPI_SEL_LSB) & 3u);
+
+	/* ungate SPI4 bus clock (IFRAO4 bit25) */
+	twr(st.infra, TP_SPI4_CG_CLR, TP_SPI4_CG_BIT);
+	uint32_t sta = trd(st.infra, TP_SPI4_CG_STA);
+	printf("SWEET TOUCH: spi4 cg sta=%#x\n", sta);
+	if (sta & TP_SPI4_CG_BIT) {
+		printf("SWEET TOUCH: spi4 clock still gated; aborting before MMIO access\n");
+		return false;
+	}
+
+	/* engine idle, CS released */
+	twr(st.spi, SPI_CMD, SPI_PAUSE_EN);
+	twr(st.spi, SPI_PADSEL, 0);
+	/* mode0, MSB first, 8-bit, no endian swap */
+	uint32_t cmd = SPI_PAUSE_EN | SPI_TXMSBF | SPI_RXMSBF |
+	    SPI_FINISH_IE | SPI_PAUSE_IE;
+	twr(st.spi, SPI_CMD, cmd);
+	/* The live controller is mediatek,mt6765-spi, which uses CFG2 for
+	 * SCK timing. spi_sel is forced to 26 MHz, so 13 ticks per edge is
+	 * a conservative 1 MHz clock (well below the DT's 9.6 MHz limit). */
+	uint32_t sck_time = 13u;
+	twr(st.spi, SPI_CFG0,
+	    ((24u & 0xffu) << 16) |        /* cs_hold */
+	    ((24u & 0xffu) << 24));        /* cs_setup */
+	twr(st.spi, SPI_CFG2,
+	    ((sck_time - 1u) & 0xffffu) |
+	    (((sck_time - 1u) & 0xffffu) << 16));
+	twr(st.spi, SPI_CFG1, 1u);         /* cs_idle = 2 ticks */
+	printf("SWEET TOUCH: spi cfg0=%#x cfg1=%#x cfg2=%#x cmd=%#x\n",
+	    trd(st.spi, SPI_CFG0), trd(st.spi, SPI_CFG1),
+	    trd(st.spi, SPI_CFG2), trd(st.spi, SPI_CMD));
+	return true;
+}
+
+/* CS control: bit-banged GPIO98 for the whole message; PAUSE_EN mirrors
+ * the vendor set_cs() (set = CS released / idle). */
+static void
+tp_cs(bool low)
+{
+	gpio_out(TP_PIN_CSB, !low);
+	if (low) {
+		twr(st.spi, SPI_CMD, trd(st.spi, SPI_CMD) & ~SPI_PAUSE_EN);
+	} else {
+		twr(st.spi, SPI_CMD, trd(st.spi, SPI_CMD) | SPI_PAUSE_EN);
+	}
+}
+
+static bool spi_done(void);
+
+/* DMA buffers: one cache-line-aligned bounce for each direction.  The
+ * mt65xx engine DMAs >32-byte transfers as a whole packet chain; FIFO
+ * mode stalls on the second packet (st0=0, vendor uses DMA there too). */
+static uint8_t sdma_tx[NVT_XFER_LEN + 32] __attribute__((aligned(64)));
+static uint8_t sdma_rx[128] __attribute__((aligned(64)));
+
+static void
+dcache_clean(const void *p, size_t n)
+{
+	uintptr_t a = (uintptr_t)p & ~63ull;
+	uintptr_t e = ((uintptr_t)p + n + 63) & ~63ull;
+	for (; a < e; a += 64) {
+		__asm__ volatile("dc cvau, %0" :: "r"(a) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+dcache_inval(const void *p, size_t n)
+{
+	uintptr_t a = (uintptr_t)p & ~63ull;
+	uintptr_t e = ((uintptr_t)p + n + 63) & ~63ull;
+	for (; a < e; a += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(a) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint64_t
+kphys(const void *va)
+{
+	uint64_t a = (uint64_t)(uintptr_t)va;
+	return ((uint64_t)pmap_find_phys(kernel_pmap, a) << 12) | (a & 0xffful);
+}
+
+/* One DMA shot for a 32-byte-multiple span inside the caller's CS window. */
+static bool
+spi_dma(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	uint32_t cmd = trd(st.spi, SPI_CMD);
+	uint32_t c1 = trd(st.spi, SPI_CFG1);
+	c1 = (c1 & ~0x3ffff00u) | ((32u - 1u) << 16) |
+	    (((len / 32u) - 1u) << 8);
+	twr(st.spi, SPI_CFG1, c1);
+	if (tx) {
+		if (len > sizeof(sdma_tx)) {
+			return false;
+		}
+		for (unsigned i = 0; i < len; ++i) {
+			sdma_tx[i] = tx[i];
+		}
+		dcache_clean(sdma_tx, len);
+		uint64_t pa = kphys(sdma_tx);
+		twr(st.spi, SPI_TX_SRC, (uint32_t)pa);
+		twr(st.spi, SPI_TX_SRC_64, (uint32_t)(pa >> 32));
+		cmd |= SPI_CMD_TX_DMA;
+	} else {
+		cmd &= ~SPI_CMD_TX_DMA;
+	}
+	if (rx) {
+		if (len > sizeof(sdma_rx)) {
+			return false;
+		}
+		uint64_t pa = kphys(sdma_rx);
+		twr(st.spi, SPI_RX_DST, (uint32_t)pa);
+		twr(st.spi, SPI_RX_DST_64, (uint32_t)(pa >> 32));
+		cmd |= SPI_CMD_RX_DMA;
+	} else {
+		cmd &= ~SPI_CMD_RX_DMA;
+	}
+	twr(st.spi, SPI_ST0, trd(st.spi, SPI_ST0)); /* w1c */
+	twr(st.spi, SPI_CMD, (cmd & ~SPI_RESUME) | SPI_ACT);
+	if (!spi_done()) {
+		printf("SWEET TOUCH: spi dma timeout len=%u txpa=%#llx rxpa=%#llx st0=%#x st1=%#x cfg1=%#x cmd=%#x\n",
+		    len,
+		    tx ? (unsigned long long)((uint64_t)trd(st.spi, SPI_TX_SRC_64) << 32 |
+		        trd(st.spi, SPI_TX_SRC)) : 0ull,
+		    rx ? (unsigned long long)((uint64_t)trd(st.spi, SPI_RX_DST_64) << 32 |
+		        trd(st.spi, SPI_RX_DST)) : 0ull,
+		    trd(st.spi, SPI_ST0), trd(st.spi, SPI_ST1),
+		    trd(st.spi, SPI_CFG1), trd(st.spi, SPI_CMD));
+		twr(st.spi, SPI_CMD,
+		    trd(st.spi, SPI_CMD) & ~(SPI_CMD_TX_DMA | SPI_CMD_RX_DMA));
+		return false;
+	}
+	twr(st.spi, SPI_CMD,
+	    trd(st.spi, SPI_CMD) & ~(SPI_CMD_TX_DMA | SPI_CMD_RX_DMA));
+	if (rx) {
+		dcache_inval(sdma_rx, len);
+		for (unsigned i = 0; i < len; ++i) {
+			rx[i] = sdma_rx[i];
+		}
+	}
+	return true;
+}
+
+static bool
+spi_done(void)
+{
+	uint32_t s;
+	for (unsigned i = 0; i < 40000; ++i) {
+		s = trd(st.spi, SPI_ST0);
+		if (s & SPI_ST0_FINISH) {
+			return true;
+		}
+		/* The engine pauses between packets; on this rev the pause
+		 * shows in STATUS1 bit0 rather than the ST0 pause flag, so
+		 * resume on either to keep the packet chain moving. */
+		if ((s & SPI_ST0_PAUSE) || (trd(st.spi, SPI_ST1) & 1u)) {
+			twr(st.spi, SPI_CMD, trd(st.spi, SPI_CMD) | SPI_RESUME);
+		}
+	}
+	return false;
+}
+
+/*
+ * Pump one transfer through the 32-byte FIFO. CS must already be handled
+ * by the caller. tx/rx may be NULL (sends 0x00 / discards). Byte packing:
+ * little-endian word writes, matching iowrite32_rep in spi-mt65xx.
+ */
+static bool
+spi_xfer(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	unsigned off = 0;
+	/* vendor: >32-byte transfers run as one DMA packet chain; the FIFO
+	 * path is only for the <=31-byte tail. */
+	unsigned dma_len = len & ~31u;
+	if (dma_len) {
+		if (!spi_dma(tx, rx, dma_len)) {
+			return false;
+		}
+		off = dma_len;
+		if (tx) {
+			tx += dma_len;
+		}
+		if (rx) {
+			rx += dma_len;
+		}
+	}
+	twr(st.spi, SPI_CMD, trd(st.spi, SPI_CMD) | SPI_RST);
+	twr(st.spi, SPI_CMD, trd(st.spi, SPI_CMD) & ~SPI_RST);
+	while (off < len) {
+		unsigned n = len - off;
+		if (n > SPI_FIFO) {
+			n = SPI_FIFO;
+		}
+		/* packet = n bytes, single loop; keep cs_idle (bits0-7) */
+		uint32_t c1 = trd(st.spi, SPI_CFG1);
+		c1 = (c1 & ~0x3ffff00u) | ((n - 1u) << 16);
+		twr(st.spi, SPI_CFG1, c1);
+		/* fill TX fifo */
+		unsigned i = 0;
+		while (i + 4u <= n) {
+			uint32_t v = 0;
+			for (unsigned b = 0; b < 4; ++b) {
+				v |= (uint32_t)(tx ? tx[off + i + b] : 0) << (8 * b);
+			}
+			twr(st.spi, SPI_TXD, v);
+			i += 4;
+		}
+		if (i < n) {
+			uint32_t v = 0;
+			for (unsigned b = 0; i + b < n; ++b) {
+				v |= (uint32_t)(tx ? tx[off + i + b] : 0) << (8 * b);
+			}
+			twr(st.spi, SPI_TXD, v);
+		}
+		twr(st.spi, SPI_ST0, trd(st.spi, SPI_ST0)); /* w1c */
+		twr(st.spi, SPI_CMD, trd(st.spi, SPI_CMD) | SPI_ACT);
+		if (!spi_done()) {
+			printf("SWEET TOUCH: spi finish timeout off=%u n=%u len=%u st0=%#x st1=%#x cfg1=%#x cmd=%#x\n",
+			    off, n, len, trd(st.spi, SPI_ST0),
+			    trd(st.spi, SPI_ST1), trd(st.spi, SPI_CFG1),
+			    trd(st.spi, SPI_CMD));
+			return false;
+		}
+		/* drain RX fifo */
+		i = 0;
+		while (i + 4u <= n) {
+			uint32_t v = trd(st.spi, SPI_RXD);
+			if (rx) {
+				for (unsigned b = 0; b < 4; ++b) {
+					rx[off + i + b] = (uint8_t)(v >> (8 * b));
+				}
+			}
+			i += 4;
+		}
+		if (i < n) {
+			uint32_t v = trd(st.spi, SPI_RXD);
+			if (rx) {
+				for (unsigned b = 0; i + b < n; ++b) {
+					rx[off + i + b] = (uint8_t)(v >> (8 * b));
+				}
+			}
+		}
+		off += n;
+	}
+	return true;
+}
+
+/* --- NVT protocol ---------------------------------------------------- */
+static void
+nvt_page(uint32_t addr)
+{
+	uint8_t b[3];
+	tp_cs(true);
+	b[0] = 0xff;
+	b[1] = (addr >> 15) & 0xff;
+	b[2] = (addr >> 7) & 0xff;
+	(void)spi_xfer(b, NULL, 3);
+	tp_cs(false);
+}
+
+/* write data[] to (page-set) offset; buf[0]=offset|0x80 (SPI_WRITE_MASK) */
+static bool
+nvt_write(uint8_t off, const uint8_t *data, unsigned n)
+{
+	uint8_t b[NVT_XFER_LEN + 1];
+	if (n > NVT_XFER_LEN) {
+		return false;
+	}
+	b[0] = off | 0x80u;
+	for (unsigned i = 0; i < n; ++i) {
+		b[1 + i] = data[i];
+	}
+	tp_cs(true);
+	bool ok = spi_xfer(b, NULL, n + 1);
+	tp_cs(false);
+	return ok;
+}
+
+static bool
+nvt_write_addr(uint32_t addr, uint8_t val)
+{
+	nvt_page(addr);
+	return nvt_write((uint8_t)(addr & 0x7f), &val, 1);
+}
+
+/*
+ * read n-1 bytes at offset into buf[1..n-1] (vendor CTP_SPI_READ
+ * convention).  The wire transfer is n+1 bytes: the offset byte, then the
+ * chip drives one dummy byte on MISO, then the data.  buf[0] keeps the
+ * transmitted offset like the vendor helper.
+ */
+static bool
+nvt_read(uint8_t off, uint8_t *buf, unsigned n)
+{
+	uint8_t tx[100], rx[100];
+	if (n + 1 > sizeof(tx)) {
+		return false;
+	}
+	tx[0] = off & 0x7f;
+	for (unsigned i = 1; i <= n; ++i) {
+		tx[i] = 0;
+	}
+	tp_cs(true);
+	bool ok = spi_xfer(tx, rx, n + 1);
+	tp_cs(false);
+	if (ok) {
+		buf[0] = tx[0];
+		for (unsigned i = 1; i < n; ++i) {
+			buf[i] = rx[i + 1];
+		}
+	}
+	return ok;
+}
+
+static void
+nvt_bl_reset(void)
+{
+	(void)nvt_write_addr(NVT_SWRST_N8, 0x69);
+	twait(10);
+}
+
+static void
+nvt_eng_reset(void)
+{
+	(void)nvt_write_addr(NVT_ENG_RST, 0x5a);
+	twait(1);
+}
+
+/* read reset-complete state byte at EVENT page 0x60 */
+static bool
+nvt_state_at_least(uint8_t want, unsigned retries)
+{
+	uint8_t b[8];
+	nvt_page(NVT_EVENT_BUF);
+	for (unsigned i = 0; i < retries; ++i) {
+		b[0] = NVT_EV_RST_DONE;
+		if (nvt_read(NVT_EV_RST_DONE, b, 6) &&
+		    b[1] >= want && b[1] <= NVT_ST_MAX) {
+			return true;
+		}
+		twait(10);
+	}
+	return false;
+}
+
+static bool
+nvt_detect(uint8_t id[6])
+{
+	uint8_t b[8];
+	for (unsigned t = 0; t < 5; ++t) {
+		nvt_bl_reset();
+		nvt_page(NVT_CHIP_PAGE);
+		b[0] = NVT_CHIP_OFF;
+		if (!nvt_read(NVT_CHIP_OFF, b, 7)) {
+			continue;
+		}
+		for (unsigned i = 0; i < 6; ++i) {
+			id[i] = b[1 + i];
+		}
+		printf("SWEET TOUCH: nvt id try%u = %02x %02x %02x %02x %02x %02x\n",
+		    t, id[0], id[1], id[2], id[3], id[4], id[5]);
+		/* NT36672C trim: mask{1,0,0,1,1,1} on {0x0c,x,x,0x72,0x66,0x03} */
+		if (id[0] == 0x0c && id[3] == 0x72 && id[4] == 0x66 && id[5] == 0x03) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* --- firmware download (noflash host download) ----------------------- */
+static uint32_t
+le32_get(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+	    ((uint32_t)p[3] << 24);
+}
+
+struct nvt_part {
+	uint32_t bin, sram, size, crc;
+};
+
+/* write one partition's payload to SRAM in 256-byte page-write chunks */
+static bool
+nvt_write_part(const struct nvt_part *p, const uint8_t *fw, unsigned fwsize)
+{
+	if (p->size == 0) {
+		return true;
+	}
+	if (p->bin + p->size > fwsize) {
+		return false;
+	}
+	uint32_t sram = p->sram, bin = p->bin, size = p->size + 1;
+	while (size) {
+		unsigned len = size < NVT_XFER_LEN ? size : NVT_XFER_LEN;
+		nvt_page(sram);
+		if (!nvt_write((uint8_t)(sram & 0x7f), fw + bin, len)) {
+			return false;
+		}
+		sram += NVT_XFER_LEN;
+		bin += NVT_XFER_LEN;
+		size = size > NVT_XFER_LEN ? size - NVT_XFER_LEN : 0;
+	}
+	return true;
+}
+
+static void
+nvt_crc_bank(uint32_t des, uint32_t sram, uint32_t len_addr, uint32_t size,
+    uint32_t gchk, uint32_t crc)
+{
+	uint8_t b[6];
+	nvt_page(des);
+	b[0] = sram & 0xff;
+	b[1] = (sram >> 8) & 0xff;
+	b[2] = (sram >> 16) & 0xff;
+	(void)nvt_write((uint8_t)(des & 0x7f), b, 3);
+	b[0] = size & 0xff;
+	b[1] = (size >> 8) & 0xff;
+	b[2] = (size >> 16) & 1;
+	(void)nvt_write((uint8_t)(len_addr & 0x7f), b, 3);
+	b[0] = crc & 0xff;
+	b[1] = (crc >> 8) & 0xff;
+	b[2] = (crc >> 16) & 0xff;
+	b[3] = (crc >> 24) & 0xff;
+	(void)nvt_write((uint8_t)(gchk & 0x7f), b, 4);
+}
+
+static bool
+nvt_download(const uint8_t *fw, unsigned fwsize)
+{
+	struct nvt_part part[24];
+	unsigned ilm_dlm = 2, info = 0, ovly, np = 0;
+	uint32_t tmp_end = le32_get(fw);
+	for (uint32_t pos = 0x30; pos < tmp_end; pos += 0x10) {
+		++info;
+	}
+	ovly = (fw[0x28] & 0x10) ? (fw[0x28] & 0x0f) : 0;
+	np = ilm_dlm + info + ovly;
+	if (np > sizeof(part) / sizeof(part[0])) {
+		printf("SWEET TOUCH: nvt fw partitions %u > max\n", np);
+		return false;
+	}
+	for (unsigned i = 0; i < np; ++i) {
+		struct nvt_part *p = &part[i];
+		p->crc = 0;
+		if (i < ilm_dlm) {
+			p->bin = le32_get(fw + i * 12);
+			p->sram = le32_get(fw + i * 12 + 4);
+			p->size = le32_get(fw + i * 12 + 8);
+			p->crc = le32_get(fw + 0x18 + i * 4);
+		} else if (i < ilm_dlm + info) {
+			uint32_t pos = 0x30 + 0x10 * (i - ilm_dlm);
+			p->sram = le32_get(fw + pos);
+			p->size = le32_get(fw + pos + 4);
+			p->bin = le32_get(fw + pos + 8);
+			p->crc = le32_get(fw + pos + 12);
+		} else {
+			uint32_t pos = part[1].bin + 0x10 * (i - ilm_dlm - info);
+			p->sram = le32_get(fw + pos);
+			p->size = le32_get(fw + pos + 4);
+			p->bin = le32_get(fw + pos + 8);
+			p->crc = le32_get(fw + pos + 12);
+		}
+		if (p->size && p->bin + p->size > fwsize) {
+			printf("SWEET TOUCH: nvt fw part%u out of range\n", i);
+			return false;
+		}
+	}
+	printf("SWEET TOUCH: nvt fw parts=%u ilm(sram=%#x sz=%#x crc=%#x) dlm(sram=%#x sz=%#x crc=%#x)\n",
+	    np, part[0].sram, part[0].size, part[0].crc,
+	    part[1].sram, part[1].size, part[1].crc);
+
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		nvt_bl_reset();
+		/* Write_Partition */
+		bool ok = true;
+		for (unsigned i = 0; i < np && ok; ++i) {
+			ok = nvt_write_part(&part[i], fw, fwsize);
+		}
+		if (!ok) {
+			continue;
+		}
+		/* nvt_set_bld_hw_crc: ILM + DLM banks */
+		nvt_crc_bank(NVT_ILM_DES, part[0].sram, NVT_ILM_LEN, part[0].size,
+		    NVT_G_ILM_CHK, part[0].crc);
+		nvt_crc_bank(NVT_DLM_DES, part[1].sram, NVT_DLM_LEN, part[1].size,
+		    NVT_G_DLM_CHK, part[1].crc);
+		/* nvt_bld_crc_enable: BLD_CRC_EN |= 0x80 */
+		uint8_t b[4];
+		nvt_page(NVT_BLD_CRC_EN);
+		b[0] = NVT_BLD_CRC_EN & 0x7f;
+		(void)nvt_read(NVT_BLD_CRC_EN & 0x7f, b, 2);
+		b[0] = b[1] | 0x80;
+		(void)nvt_write(NVT_BLD_CRC_EN & 0x7f, b, 1);
+		/* nvt_fw_crc_enable: clear reset status + host cmd 0xAE */
+		nvt_page(NVT_EVENT_BUF);
+		b[0] = 0;
+		(void)nvt_write(NVT_EV_RST_DONE, b, 1);
+		b[0] = 0xae;
+		(void)nvt_write(NVT_EV_HOST_CMD, b, 1);
+		/* nvt_boot_ready */
+		(void)nvt_write_addr(NVT_BOOT_RDY, 1);
+		twait(5);
+		nvt_page(NVT_EVENT_BUF);
+		if (nvt_state_at_least(NVT_ST_INIT, 10)) {
+			printf("SWEET TOUCH: nvt fw download ok (attempt %u)\n", attempt);
+			return true;
+		}
+	}
+	printf("SWEET TOUCH: nvt fw download failed\n");
+	return false;
+}
+
+static void
+nvt_fwinfo(void)
+{
+	uint8_t b[20];
+	nvt_page(NVT_EVENT_BUF);
+	b[0] = NVT_EV_FWINFO;
+	if (nvt_read(NVT_EV_FWINFO, b, 17)) {
+		printf("SWEET TOUCH: nvt fw ver=%#x bar=%#x pid? %02x%02x\n",
+		    b[1], b[2], b[14], b[15]);
+	}
+	nvt_page(NVT_EVENT_BUF);
+}
+
+/* --- report decode --------------------------------------------------- */
+static void
+touch_report(uint32_t mask, const int *x, const int *y)
+{
+	uint32_t up = st.active & ~mask;
+	for (unsigned id = 0; id < TP_TOUCH_MAX; ++id) {
+		if (mask & (1u << id)) {
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+			sweet_hid_touch((int)id, 1, x[id], y[id]);
+		} else if (up & (1u << id)) {
+			sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+/* poll one point packet; returns 0 on success */
+static int
+nvt_points(void)
+{
+	uint8_t buf[NVT_POINT_LEN + 2];
+	int x[TP_TOUCH_MAX] = {0}, y[TP_TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+
+	buf[0] = 0;
+	if (!nvt_read(0, buf, NVT_POINT_LEN + 1)) {
+		return EIO;
+	}
+	/* recovery frames: all 0x77 -> fw needs redownload; 0xFD/FE -> wdt */
+	{
+		unsigned same77 = 1, fdfe = 0;
+		for (unsigned i = 0; i < 10; ++i) {
+			if (buf[1 + i] != 0x77) {
+				same77 = 0;
+			}
+			if (buf[1 + i] == 0xfd || buf[1 + i] == 0xfe) {
+				++fdfe;
+			}
+		}
+		if (same77 || fdfe == 10) {
+			return EAGAIN;
+		}
+	}
+	/* checksum over buf[1..64] -> buf[65] */
+	uint8_t cks = 0;
+	for (unsigned i = 0; i < 64; ++i) {
+		cks += buf[1 + i];
+	}
+	cks = (uint8_t)(~cks + 1);
+	if (cks != buf[65]) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < TP_TOUCH_MAX; ++i) {
+		unsigned pos = 1 + 6 * i;
+		uint8_t id = (buf[pos] >> 3) - 1;
+		if (id >= TP_TOUCH_MAX) {
+			continue;
+		}
+		if ((buf[pos] & 7) == 1 || (buf[pos] & 7) == 2) {
+			x[id] = (buf[pos + 1] << 4) | (buf[pos + 3] >> 4);
+			y[id] = (buf[pos + 2] << 4) | (buf[pos + 3] & 0x0f);
+			if (x[id] > 1079 || y[id] > 2399) {
+				return EIO;
+			}
+			mask |= 1u << id;
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+/* pulse reset on `pin`, then run the NVT chip-id probe */
+static bool
+nvt_reset_and_detect(unsigned pin, uint8_t id[6])
+{
+	gpio_mode(pin, 0);
+	gpio_dir(pin, true);
+	gpio_out(pin, false);
+	twait(10);
+	gpio_out(pin, true);
+	twait(60);
+	nvt_eng_reset();
+	gpio_out(pin, true);
+	printf("SWEET TOUCH: din after rst%u: irq=%d r33=%d r43=%d csb=%d\n",
+	    pin, gpio_in(TP_PIN_IRQ), gpio_in(33), gpio_in(43), gpio_in(TP_PIN_CSB));
+	return nvt_detect(id);
+}
+
+/* --- init + poll thread ---------------------------------------------- */
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 0;
+	uint8_t id[6] = {0};
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	if (delay_s) {
+		printf("SWEET TOUCH: mt6853 spi4 starting in %u s\n", delay_s);
+		twait(delay_s * 1000u);
+	} else {
+		printf("SWEET TOUCH: mt6853 spi4 starting now\n");
+	}
+
+	st.spi = ml_io_map(TP_SPI4_PA, 0x400);
+	st.gpio = ml_io_map(TP_GPIO_PA, 0x800);
+	st.infra = ml_io_map(TP_INFRA_PA, 0x1000);
+	st.lm = ml_io_map(TP_IOC_LM, 0x1000);
+	st.bm = ml_io_map(TP_IOC_BM, 0x1000);
+	st.tl = ml_io_map(TP_IOC_TL, 0x1000);
+	st.i2c = ml_io_map(TP_I2C5_PA, 0x1000);
+	st.i2c_dma = ml_io_map(TP_I2C5_DMA_PA, 0x80);
+	st.impiic = ml_io_map(TP_IMPIIC_PA, 0x1000);
+	st.topck = ml_io_map(TP_TOPCK_PA, 0x1000);
+	if (!st.spi || !st.gpio || !st.infra || !st.lm || !st.bm || !st.tl ||
+	    !st.i2c || !st.i2c_dma || !st.impiic || !st.topck) {
+		printf("SWEET TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+
+	/* pinmux: SPI4 pins f2; CSB stays a GPIO we bit-bang ourselves */
+	gpio_mode(TP_PIN_MI, 2);
+	gpio_mode(TP_PIN_MO, 2);
+	gpio_mode(TP_PIN_CLK, 2);
+	gpio_mode(TP_PIN_CSB, 0);
+	gpio_dir(TP_PIN_CSB, true);
+	gpio_out(TP_PIN_CSB, true);
+	gpio_mode(TP_PIN_IRQ, 0);
+	gpio_dir(TP_PIN_IRQ, false);
+	/* iocfg: input-enable on MI/IRQ, pull-up on IRQ (matches int_active) */
+	twr(st.lm, 0x0050, trd(st.lm, 0x0050) | (1u << 10)); /* GPIO12 IES */
+	twr(st.tl, 0x0040, trd(st.tl, 0x0040) | (1u << 2));  /* GPIO14 IES */
+	twr(st.tl, 0x0070, trd(st.tl, 0x0070) | (1u << 2));  /* GPIO14 PU */
+
+	/* Stock pinctrl holds GPIO43 output-high in the active state (TP
+	 * enable/reset companion line); mirror it so the rail stays up. */
+	gpio_mode(TP_PIN_RST2, 0);
+	gpio_dir(TP_PIN_RST2, true);
+	gpio_out(TP_PIN_RST2, true);
+
+	/* optional VTP LDO2 on i2c5 (sweetvtp=1); off by default since the
+	 * 20611 touch node declares no supply -- the TDDI is powered via the
+	 * panel, which is already on. */
+	int sweetvtp = 0;
+	(void)PE_parse_boot_argn("sweetvtp", &sweetvtp, sizeof(sweetvtp));
+	if (sweetvtp) {
+		vtp_power_on();
+	} else {
+		printf("SWEET TOUCH: vtp ldo2 skipped (sweetvtp=0; 20611 wires no tp supply)\n");
+	}
+
+	if (!spi_config()) {
+		goto out;
+	}
+	printf("SWEET TOUCH: din at start: irq=%d r33=%d r43=%d csb=%d mi=%d\n",
+	    gpio_in(TP_PIN_IRQ), gpio_in(33), gpio_in(43),
+	    gpio_in(TP_PIN_CSB), gpio_in(TP_PIN_MI));
+
+	/* Project 20611 uses GPIO33; retain GPIO43 pulse as an alternate. */
+	bool detected = nvt_reset_and_detect(TP_PIN_RST, id);
+	if (!detected) {
+		printf("SWEET TOUCH: retrying with reset GPIO43\n");
+		detected = nvt_reset_and_detect(TP_PIN_RST2, id);
+		/* GPIO43 is a hold-high line in stock; restore it. */
+		gpio_out(TP_PIN_RST2, true);
+	}
+	if (!detected) {
+		printf("SWEET TOUCH: no NT36672C id (%02x %02x %02x %02x %02x %02x); "
+		    "panel may be Himax HX83112F or Ilitek ILI7807S -- not supported yet\n",
+		    id[0], id[1], id[2], id[3], id[4], id[5]);
+		goto out;
+	}
+	st.have_nvt = true;
+	printf("SWEET TOUCH: NT36672C detected; downloading %u-byte fw\n",
+	    sweet_nvt_fw_size);
+
+	if (!nvt_download(sweet_nvt_fw, sweet_nvt_fw_size)) {
+		goto out;
+	}
+	if (!nvt_state_at_least(NVT_ST_NORMAL, 100)) {
+		printf("SWEET TOUCH: nvt fw not in normal-run state\n");
+	}
+	nvt_fwinfo();
+	printf("SWEET TOUCH: running (1080x2400, irq=gpio14, poll=8ms)\n");
+
+	unsigned recoveries = 0, tick = 0;
+	while (!st.dead) {
+		int err = nvt_points();
+		if (err == EAGAIN && recoveries++ < 3) {
+			printf("SWEET TOUCH: nvt recovery frame; re-downloading fw\n");
+			(void)nvt_download(sweet_nvt_fw, sweet_nvt_fw_size);
+		}
+		if ((++tick % 625u) == 0) {
+			printf("SWEET TOUCH: alive irq=%d act=%#x err=%d\n",
+			    gpio_in(TP_PIN_IRQ), st.active, err);
+		}
+		twait(8);
+	}
+	touch_report(0, st.x, st.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (st.started) {
+		return;
+	}
+	st.started = true;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET TOUCH: disabled (sweettouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
