diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 0000000..0000000 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -707,8 +707,22 @@
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+
+	/*
+	 * rmx2117: fb (0x77e00000) and dsi0 (0x14000000) live in the V=P
+	 * L1[0] range (below the kernel's 4-6 GiB window in L1[1]), which
+	 * create_bootstrap_mapping leaves empty - the two L2 blocks above
+	 * sat in a table no L1 entry referenced. Link L1[0] at the same L2
+	 * page; index ranges do not overlap (RAM uses 0-63, dsi0 160,
+	 * fb 959).
+	 */
+	add		x10, x25, #(2 * PGBYTES)
+	mov		x11, #(ARM_TTE_BOOT_TABLE)
+	and		x12, x10, #(ARM_TTE_TABLE_MASK)
+	orr		x11, x11, x12
+	str		x11, [x25]
 #endif
 
 	/* Ensure TTEs are visible */
 	dsb		ish
