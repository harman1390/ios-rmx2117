+++ b/bsd/dev/sweet_cam.c
@@ -0,0 +1,348 @@
+/*
+ * SWEET camera probe for RMX2117 (MT6853) -- probe level only.
+ *
+ * Board camera facts (vendor cust_mt6853_camera_20611.dtsi):
+ *   cam0 = s5kgm1st_mipi_raw_20611 (main), cam1 = s5k3p9sp (front)
+ *   CCI  = i2c2 @ 0x11d21000 (mtk i2c v6, same reg layout as i2c5),
+ *          SCL=GPIO101 SDA=GPIO102 (iocfg BR @0x11d40000), imp_iic_wrap_ws
+ *          @0x11d23000 gates the i2c2 clock
+ *   vcamio = MT6359 LDO_VCAMIO_OP_EN (pmic 0x1c58, bit0)
+ *   cam0 vcama = GPIO91, cam0 vcamd = GPIO55 (sel GPIO88), rst = GPIO54
+ *   cam1 rst = GPIO60
+ *
+ * Probe sequence: ungate i2c2 clock, power vcamio + cam0 vcama/vcamd,
+ * deassert cam0 reset, then read the sensor chip-id register
+ * (s5kgm1st: reg 0x0000/0x0001 = 0x882D per vendor sensor driver
+ * convention) at the common Samsung CCI addresses.  All waits bounded;
+ * rails are left ON only when a sensor answers, otherwise rolled back.
+ *
+ * Boot-arg: sweetcam=1 (default off).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/proc.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_pwrap_lock(void);
+extern void sweet_pwrap_unlock(void);
+void sweet_cam_init(void);
+
+#define CAM_I2C2_PA     0x11d21000u
+#define CAM_I2C2_DMA_PA 0x10217180u
+#define CAM_IMPWS_PA    0x11d23000u /* imp_iic_wrap_ws gate block */
+#define CAM_IMPWS_I2C2  (1u << 1)   /* gate idx: i2c1=0, i2c2=1, i2c4=2 */
+#define CAM_GPIO_PA     0x10005000u
+#define CAM_IOC_BR_PA   0x11d40000u
+#define CAM_PWRAP_PA    0x10026000u
+#define CAM_TOPCK_PA    0x10000000u
+
+#define PIN_CAM_SCL     101u
+#define PIN_CAM_SDA     102u
+#define PIN_I2C_FUNC    1u
+#define PIN_CAM0_RST    54u
+#define PIN_CAM0_VCAMD  55u
+#define PIN_CAM0_VCAMA  91u
+#define PIN_VCAMD_SEL   88u
+#define PIN_CAM1_RST    60u
+
+#define PWRAP_ACC    0x0c80u
+#define PWRAP_WDATA  0x0c84u
+#define PWRAP_RDATA  0x0c94u
+#define PWRAP_VLDCLR 0x0ca4u
+#define PWRAP_STA    0x0ca8u
+#define PWRAP_FSM(x) (((x) >> 1) & 7u)
+#define PWRAP_IDLE   0u
+#define PWRAP_WFVLD  6u
+#define PMIC_VCAMIO_EN_SET 0x1c5au /* LDO_VCAMIO_OP_EN_SET */
+
+/* mtk i2c v6 regs (same as i2c5/torch) */
+#define I2C_DATA      0x00u
+#define I2C_SLAVE     0x04u
+#define I2C_ISTAT     0x0cu
+#define I2C_CONTROL   0x10u
+#define I2C_XFER_LEN  0x14u
+#define I2C_TRANS_LEN 0x18u
+#define I2C_DELAY     0x1cu
+#define I2C_TIMING    0x20u
+#define I2C_START     0x24u
+#define I2C_EXT_CONF  0x28u
+#define I2C_FIFO_CLR  0x38u
+#define I2C_IOCFG     0x40u
+#define I2C_HS        0x48u
+#define I2C_SOFTRST   0x50u
+#define I2C_DCM_EN    0x54u
+#define I2C_XFER_AUX  0x6cu
+#define CTL_RS        0x02u
+#define CTL_CLK_EXT   0x08u
+#define CTL_DIR_CHG   0x10u
+#define CTL_ACKERR    0x20u
+
+static vm_offset_t g_i2c, g_i2c_dma, g_impws, g_gpio, g_ioc, g_pwrap,
+    g_topck;
+static int g_started, g_alive;
+static void *g_node;
+
+static uint32_t
+r32(vm_offset_t b, uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(b + o);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+w32(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint16_t
+i2cr(uint32_t off)
+{
+	return *(volatile uint16_t *)(g_i2c + off);
+}
+
+static void
+i2cw(uint32_t off, uint16_t v)
+{
+	*(volatile uint16_t *)(g_i2c + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+gpio_dir(unsigned pin, int out)
+{
+	volatile uint32_t *d =
+	    (volatile uint32_t *)(g_gpio + 0x0000 + (pin / 32u) * 0x10u);
+	if (out)
+		*d |= (1u << (pin & 31u));
+	else
+		*d &= ~(1u << (pin & 31u));
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+gpio_out(unsigned pin, int hi)
+{
+	volatile uint32_t *d =
+	    (volatile uint32_t *)(g_gpio + 0x0200 + (pin / 32u) * 0x10u);
+	if (hi)
+		*d |= (1u << (pin & 31u));
+	else
+		*d &= ~(1u << (pin & 31u));
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+gpio_mode(unsigned pin, unsigned func)
+{
+	volatile uint32_t *m =
+	    (volatile uint32_t *)(g_gpio + 0x0300 + (pin / 8u) * 0x10u);
+	*m = (*m & ~(0xfu << ((pin & 7u) * 4u))) |
+	    (func << ((pin & 7u) * 4u));
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static int
+pwait(uint32_t want)
+{
+	for (int i = 0; i < 1000; ++i) {
+		if (PWRAP_FSM(r32(g_pwrap, PWRAP_STA)) == want)
+			return 0;
+		delay(1);
+	}
+	return -1;
+}
+
+static int
+pmic_r(uint32_t adr, uint32_t *out)
+{
+	if (pwait(PWRAP_IDLE)) {
+		if (PWRAP_FSM(r32(g_pwrap, PWRAP_STA)) == PWRAP_WFVLD)
+			w32(g_pwrap, PWRAP_VLDCLR, 1);
+		return -1;
+	}
+	w32(g_pwrap, PWRAP_ACC, adr);
+	if (pwait(PWRAP_WFVLD))
+		return -2;
+	*out = r32(g_pwrap, PWRAP_RDATA) & 0xffffu;
+	w32(g_pwrap, PWRAP_VLDCLR, 1);
+	return 0;
+}
+
+static int
+pmic_w(uint32_t adr, uint32_t v)
+{
+	if (pwait(PWRAP_IDLE))
+		return -1;
+	w32(g_pwrap, PWRAP_WDATA, v & 0xffffu);
+	w32(g_pwrap, PWRAP_ACC, (1u << 29) | adr);
+	return pwait(PWRAP_IDLE) ? -2 : 0;
+}
+
+static uint16_t
+i2c2_xfer(uint8_t addr, const uint8_t *wr, unsigned wlen, uint8_t *rd,
+    unsigned rlen)
+{
+	uint16_t ctl = CTL_ACKERR | CTL_CLK_EXT;
+	unsigned i, spins = 100000;
+	uint16_t s = 0;
+	if (rlen)
+		ctl |= CTL_DIR_CHG | CTL_RS;
+	else
+		i2cw(I2C_DELAY, 0x0002);
+	i2cw(I2C_CONTROL, ctl);
+	i2cw(I2C_SLAVE, (uint16_t)(addr << 1));
+	i2cw(I2C_ISTAT, 0x0007);
+	i2cw(I2C_FIFO_CLR, 0x0001);
+	i2cw(I2C_XFER_LEN, (uint16_t)wlen);
+	i2cw(I2C_XFER_AUX, (uint16_t)rlen);
+	i2cw(I2C_TRANS_LEN, rlen ? 0x0002u : 0x0001u);
+	for (i = 0; i < wlen; i++)
+		i2cw(I2C_DATA, wr[i]);
+	i2cw(I2C_START, 0x0001);
+	while (spins-- && !((s = i2cr(I2C_ISTAT)) & 0x0007))
+		delay(1);
+	for (i = 0; rd && i < rlen; i++)
+		rd[i] = (uint8_t)i2cr(I2C_DATA);
+	return s;
+}
+
+/* 16-bit register read (sensor CCI convention: 2-byte reg, 1-byte data) */
+static int
+cam_rd16(uint8_t addr, uint16_t reg, uint8_t *val)
+{
+	uint8_t w[2] = { (uint8_t)(reg >> 8), (uint8_t)reg };
+	return (i2c2_xfer(addr, w, 2, val, 1) & 7u) == 1u ? 0 : -1;
+}
+
+static void
+cam_thread(void *arg, wait_result_t result)
+{
+	uint32_t v;
+	(void)arg;
+	(void)result;
+
+	/* ungate the i2c2 clock (imp_iic_wrap_ws, I2C2 gate = bit1) */
+	w32(g_impws, 0xe04, CAM_IMPWS_I2C2);
+	printf("SWEET CAM: impws sta=%#x\n", r32(g_impws, 0xe00));
+
+	/* CCI pins: i2c func + input-enable + pull-up in iocfg BR */
+	gpio_mode(PIN_CAM_SCL, PIN_I2C_FUNC);
+	gpio_mode(PIN_CAM_SDA, PIN_I2C_FUNC);
+	volatile uint32_t *ioc = (volatile uint32_t *)g_ioc;
+	ioc[0x0070 / 4] |= (3u << 9);   /* IES pins 101,102 (bits 9,10) */
+	ioc[0x00b0 / 4] |= (3u << 9);   /* PU */
+	ioc[0x0090 / 4] &= ~(3u << 9);  /* PD off */
+
+	/* i2c2 init (same as i2c5 bring-up) */
+	i2cw(I2C_START, 0);
+	w32(g_i2c_dma, 0x0c, 0x0002);
+	delay(50);
+	w32(g_i2c_dma, 0x0c, 0);
+	delay(50);
+	i2cw(I2C_SOFTRST, 1);
+	delay(50);
+	i2cw(I2C_DCM_EN, 0);
+	i2cw(I2C_IOCFG, 0);
+	i2cw(I2C_HS, 0);
+	i2cw(I2C_EXT_CONF, 0x1800);
+	i2cw(I2C_TIMING, 0x073f);
+
+	/* rails: vcamio (pmic) + cam0 vcama/vcamd (gpio) */
+	sweet_pwrap_lock();
+	v = pmic_w(PMIC_VCAMIO_EN_SET, 1) ? 0xffffffffu : 1;
+	sweet_pwrap_unlock();
+	printf("SWEET CAM: vcamio op_en=%s\n", v ? "ok" : "FAIL");
+	gpio_mode(PIN_CAM0_VCAMA, 0);
+	gpio_dir(PIN_CAM0_VCAMA, 1);
+	gpio_out(PIN_CAM0_VCAMA, 1);
+	gpio_mode(PIN_CAM0_VCAMD, 0);
+	gpio_dir(PIN_CAM0_VCAMD, 1);
+	gpio_out(PIN_CAM0_VCAMD, 1);
+	gpio_mode(PIN_VCAMD_SEL, 0);
+	gpio_dir(PIN_VCAMD_SEL, 1);
+	gpio_out(PIN_VCAMD_SEL, 1);       /* sel high per vendor pinctrl */
+	delay(1000);
+
+	/* cam0 reset release */
+	gpio_mode(PIN_CAM0_RST, 0);
+	gpio_dir(PIN_CAM0_RST, 1);
+	gpio_out(PIN_CAM0_RST, 0);
+	delay(2000);
+	gpio_out(PIN_CAM0_RST, 1);
+	delay(1000);
+
+	/* probe CCI: s5kgm1st id regs at common Samsung addrs */
+	static const uint8_t addrs[] = { 0x10, 0x20, 0x5a, 0x6c, 0x34 };
+	uint8_t hi = 0, lo = 0, found = 0;
+	for (unsigned i = 0; i < sizeof(addrs); ++i) {
+		if (cam_rd16(addrs[i], 0x0000, &hi) == 0 &&
+		    cam_rd16(addrs[i], 0x0001, &lo) == 0) {
+			printf("SWEET CAM: sensor @0x%02x id=%02x%02x\n",
+			    addrs[i], hi, lo);
+			found = 1;
+		}
+	}
+	if (!found)
+		printf("SWEET CAM: no sensor ACK on i2c2 "
+		    "(check rails/mclk/pinfunc)\n");
+	g_alive = found;
+}
+
+static const struct cdevsw cam_cdevsw = {
+	.d_open = eno_open,
+	.d_close = eno_close,
+	.d_ioctl = eno_ioctl,
+	.d_stop = eno_stop,
+	.d_reset = eno_reset,
+	.d_select = eno_select,
+	.d_mmap = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_type = D_DISK,
+};
+
+void
+sweet_cam_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (g_started)
+		return;
+	g_started = 1;
+	(void)PE_parse_boot_argn("sweetcam", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET CAM: off (sweetcam=1 to probe)\n");
+		return;
+	}
+	g_i2c = ml_io_map(CAM_I2C2_PA, 0x1000);
+	g_i2c_dma = ml_io_map(CAM_I2C2_DMA_PA, 0x1000);
+	g_impws = ml_io_map(CAM_IMPWS_PA, 0x1000);
+	g_gpio = ml_io_map(CAM_GPIO_PA, 0x1000);
+	g_ioc = ml_io_map(CAM_IOC_BR_PA, 0x1000);
+	g_pwrap = ml_io_map(CAM_PWRAP_PA, 0x1000);
+	if (!g_i2c || !g_i2c_dma || !g_impws || !g_gpio || !g_ioc ||
+	    !g_pwrap) {
+		printf("SWEET CAM: map failed\n");
+		return;
+	}
+	int maj = cdevsw_add(-1, &cam_cdevsw);
+	if (maj >= 0)
+		g_node = devfs_make_node(makedev(maj, 0), DEVFS_CHAR,
+		    UID_ROOT, GID_OPERATOR, 0660, "sweetcam");
+	kern_return_t kr = kernel_thread_start(cam_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS)
+		thread_deallocate(thread);
+	else
+		printf("SWEET CAM: thread failed %d\n", kr);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
